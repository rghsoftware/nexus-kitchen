{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-paths.sh\""
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited.sh\""
					}
				]
			}
		]
	},
	"permissions": {
		"allow": [
			"Bash(bun run lint)",
			"Bash(bun run format)",
			"Bash(bun run check)",
			"Bash(bun run test:unit:*)",
			"Bash(bunx prettier:*)",
			"Bash(bunx supabase:*)",
			"Bash(git status)",
			"Bash(git diff:*)"
		]
	}
}
