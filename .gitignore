node_modules

# Output
.output
.vercel
.netlify
.wrangler
/.svelte-kit
/build

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Playwright
test-results
playwright-report
/blob-report
/playwright/.cache

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / IDE
.idea
*.swp
*.swo
# Keep shared VS Code recommendations/settings; ignore personal overrides
.vscode/*.local.json
.history

# Claude Code — keep shared config (settings.json, commands/, agents/, skills/,
# hooks/), ignore personal/runtime-local files and agent worktrees.
.claude/settings.local.json
.claude/*.local.json
.claude/.credentials.json
# Worktrees Claude Code creates for isolated agent work — transient checkouts of
# this repo; never commit them (they also nest a .git pointer).
.claude/worktrees/

# SpecSwarm — keep shared foundation docs (constitution.md, tech-stack.md,
# conventions.md, quality-standards.md, references.md) and generated agents/hooks;
# ignore machine-generated runtime state.
.specswarm/audit.jsonl
.specswarm/**/*.local.*

# OpenCode — keep opencode.json / svelte.json, ignore generated/local files
# (lifted here so the rules survive a fresh clone; the nested .opencode/.gitignore
#  ignores itself and therefore would not travel with the repo)
.opencode/node_modules
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock

# Nimbalyst — local-only workspace state (prompts, tracker items, etc.).
# Note: .nimbalyst/ (custom tracker type definitions) is intentionally NOT
# ignored — those are meant to be committed and shared with the repo.
nimbalyst-local/

# Agent session/handoff state
.remember/
