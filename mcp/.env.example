# Hosted Supabase project URL, without a trailing slash.
SUPABASE_URL=https://your-project.supabase.co
# Public browser-safe key. Never put a secret or service-role key in this file.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Public origin of this MCP service, without a trailing slash.
MCP_BASE_URL=https://mcp.example.com

# Use "supabase" for hosted projects and current local stacks. "jwt-hs256" supports
# legacy local stacks that still issue HS256 access tokens.
MCP_AUTH_MODE=supabase
# Asymmetric signing algorithm configured by the hosted Supabase project.
SUPABASE_JWT_ALGORITHM=ES256
# Required only for MCP_AUTH_MODE=jwt-hs256; obtain it from the legacy stack's status output.
SUPABASE_JWT_SECRET=

MCP_HOST=0.0.0.0
MCP_PORT=8000
